{
  "Say": {
    "prefix": "say",
    "body": [
      "say ${1:\"Hello\"}"
    ],
    "description": "Print a value"
  },
  "Ask": {
    "prefix": "ask",
    "body": [
      "${1:name} = ask ${2:\"Question\"}"
    ],
    "description": "Ask for input"
  },
  "Use module": {
    "prefix": "use",
    "body": [
      "use ${1:module}"
    ],
    "description": "Import an SE module"
  },
  "If": {
    "prefix": "if",
    "body": [
      "if ${1:condition}",
      "    ${2:say \"yes\"}"
    ],
    "description": "if block"
  },
  "If Else": {
    "prefix": "ifelse",
    "body": [
      "if ${1:condition}",
      "    ${2:say \"yes\"}",
      "else",
      "    ${3:say \"no\"}"
    ],
    "description": "if/else block"
  },
  "Match": {
    "prefix": "match",
    "body": [
      "match ${1:value}",
      "    case ${2:pattern}",
      "        ${3:say \"matched\"}",
      "    else",
      "        ${4:say \"other\"}"
    ],
    "description": "match/case block"
  },
  "Repeat": {
    "prefix": "repeat",
    "body": [
      "repeat ${1:3}",
      "    ${2:say \"Hello\"}"
    ],
    "description": "Repeat a block"
  },
  "For": {
    "prefix": "for",
    "body": [
      "for ${1:item} in ${2:1..10}",
      "    ${3:say $1}"
    ],
    "description": "for loop"
  },
  "While": {
    "prefix": "while",
    "body": [
      "while ${1:condition}",
      "    ${2:say \"running\"}"
    ],
    "description": "while loop"
  },
  "Function": {
    "prefix": "make",
    "body": [
      "make ${1:name} ${2:arg}",
      "    ${3:give $2}"
    ],
    "description": "Create a function"
  },
  "Typed Function": {
    "prefix": "maket",
    "body": [
      "make ${1:name} ${2:value}:${3:Int} -> ${4:Int}",
      "    give ${5:$2}"
    ],
    "description": "Create a typed function"
  },
  "Type": {
    "prefix": "type",
    "body": [
      "type ${1:Name}",
      "    ${2:value = 0}",
      "",
      "    make ${3:method}",
      "        ${4:say value}"
    ],
    "description": "Create a user-defined type"
  },
  "Try Block": {
    "prefix": "tryblock",
    "body": [
      "try",
      "    ${1:text = read \"file.txt\"}",
      "else ${2:err}",
      "    ${3:say $2.message}"
    ],
    "description": "Handle a recoverable error"
  },
  "Try Expression": {
    "prefix": "try",
    "body": [
      "${1:value} = try ${2:file.read \"data.txt\"}"
    ],
    "description": "Propagate a fallible expression"
  },
  "Async Task": {
    "prefix": "async",
    "body": [
      "use async",
      "",
      "task = async.run ${1:function} ${2:arg}",
      "result = try async.await task",
      "say result"
    ],
    "description": "Run and await a managed task"
  },
  "Thread Task": {
    "prefix": "threading",
    "body": [
      "use threading",
      "",
      "task = threading.run ${1:function} ${2:arg}",
      "result = try threading.join task",
      "say result"
    ],
    "description": "Run and join a managed worker"
  },
  "SQLite": {
    "prefix": "sqlite",
    "body": [
      "use sqlite3",
      "",
      "db = sqlite3.open ${1:\"app.db\"}",
      "try sqlite3.exec db ${2:\"CREATE TABLE IF NOT EXISTS items (name TEXT)\"}",
      "rows = try sqlite3.query db ${3:\"SELECT * FROM items\"}",
      "say rows"
    ],
    "description": "Open and query SQLite"
  },
  "Regex": {
    "prefix": "regex",
    "body": [
      "use regex",
      "",
      "matched = regex.search ${1:\"[0-9]+\"} ${2:\"SE2026\"}",
      "say matched"
    ],
    "description": "Search with regex"
  },
  "HTTP GET": {
    "prefix": "httpget",
    "body": [
      "use http",
      "",
      "body = try http.get ${1:\"http://example.com\"}",
      "say body"
    ],
    "description": "Perform an HTTP GET request"
  },
  "Test": {
    "prefix": "test",
    "body": [
      "use test",
      "",
      "${1:value} = ${2:2 + 2}",
      "test.equal $1 ${3:4}"
    ],
    "description": "Create a simple SE test"
  }
}

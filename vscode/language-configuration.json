{
  "comments": {
    "lineComment": "#"
  },
  "brackets": [
    [
      "[",
      "]"
    ],
    [
      "(",
      ")"
    ]
  ],
  "autoClosingPairs": [
    {
      "open": "\"",
      "close": "\""
    },
    {
      "open": "[",
      "close": "]"
    },
    {
      "open": "(",
      "close": ")"
    }
  ],
  "surroundingPairs": [
    [
      "\"",
      "\""
    ],
    [
      "[",
      "]"
    ],
    [
      "(",
      ")"
    ]
  ],
  "indentationRules": {
    "increaseIndentPattern": "^\\\\s*(?:if|else|for|while|repeat|make|type|try|match|case)(?:\\\\s+.*)?$",
    "decreaseIndentPattern": "^\\s*else(?:\\s+\\w+)?\\s*$"
  }
}

{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "SE",
  "scopeName": "source.se",
  "fileTypes": [
    "se"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#function-declarations"
    },
    {
      "include": "#type-declarations"
    },
    {
      "include": "#generic-parameters"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#web-keywords"
    },
    {
      "include": "#control-keywords"
    },
    {
      "include": "#declaration-keywords"
    },
    {
      "include": "#builtin-types"
    },
    {
      "include": "#conversion-builtins"
    },
    {
      "include": "#builtin-modules"
    },
    {
      "include": "#builtin-functions"
    },
    {
      "include": "#member-access"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.se",
          "match": "#.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.se",
          "begin": "\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.se"
            }
          },
          "end": "\"",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.se"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.se",
              "match": "\\\\(?:n|t|r|0|\"|'|\\\\)"
            }
          ]
        }
      ]
    },
    "function-declarations": {
      "patterns": [
        {
          "match": "\\b(make)(\\s+)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.type.function.se"
            },
            "3": {
              "name": "entity.name.function.se"
            }
          }
        }
      ]
    },
    "type-declarations": {
      "patterns": [
        {
          "match": "\\b(type)(\\s+)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.type.class.se"
            },
            "3": {
              "name": "entity.name.type.se"
            }
          }
        }
      ]
    },
    "generic-parameters": {
      "patterns": [
        {
          "name": "meta.generic.se",
          "begin": "\\[",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.generic.begin.se"
            }
          },
          "end": "\\]",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.generic.end.se"
            }
          },
          "patterns": [
            {
              "name": "entity.name.type.parameter.se",
              "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
            },
            {
              "name": "punctuation.separator.comma.se",
              "match": ","
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.se",
          "match": "(?<![A-Za-z0-9_])(?:\\d+\\.\\d+|\\d+[eE][+-]?\\d+|\\d+\\.\\d+[eE][+-]?\\d+)(?:ms|s|min)?\\b"
        },
        {
          "name": "constant.numeric.integer.se",
          "match": "(?<![A-Za-z0-9_])\\d+(?:ms|s|min)?\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.se",
          "match": "\\b(?:true|false|none)\\b"
        }
      ]
    },
    "web-keywords": {
      "patterns": [
        {
          "name": "keyword.other.web.section.se",
          "match": "\\b(?:html|css|js|style)\\b"
        },
        {
          "name": "keyword.control.web.event.se",
          "match": "\\bwhen\\b"
        },
        {
          "name": "keyword.other.web.page.se",
          "match": "\\bpage\\b"
        },
        {
          "name": "keyword.other.web.native.se",
          "match": "\\bnative\\b"
        }
      ]
    },
    "control-keywords": {
      "patterns": [
        {
          "name": "keyword.control.conditional.se",
          "match": "\\b(?:if|else|match|case|try)\\b"
        },
        {
          "name": "keyword.control.loop.se",
          "match": "\\b(?:for|in|while|repeat)\\b"
        },
        {
          "name": "keyword.control.flow.se",
          "match": "\\b(?:give|fail|wait|await)\\b"
        },
        {
          "name": "keyword.operator.logical.se",
          "match": "\\b(?:and|or|not)\\b"
        }
      ]
    },
    "declaration-keywords": {
      "patterns": [
        {
          "name": "keyword.other.import.se",
          "match": "\\buse\\b"
        },
        {
          "name": "storage.type.function.se",
          "match": "\\bmake\\b"
        },
        {
          "name": "storage.type.class.se",
          "match": "\\btype\\b"
        }
      ]
    },
    "builtin-types": {
      "patterns": [
        {
          "name": "support.type.se",
          "match": "\\b(?:Int|Num|Text|Bool|Bytes|List|Map|Set|Function|Unknown|Option|Result|Task)\\b"
        }
      ]
    },
    "conversion-builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.conversion.se",
          "match": "\\b(?:int|integer|num|double|float|text|string|bool|boolean|char)\\b"
        }
      ]
    },
    "builtin-modules": {
      "patterns": [
        {
          "name": "support.namespace.se",
          "match": "\\b(?:file|path|time|math|random|os|json|text|collections|test|process|http|web|js|ts|function|async|threading|option|result|match|db|https|data|net|node|next|game|statistics|regex|re|base64|uuid|iter|itertools|copy|operator|decimal|csv|datetime|hash|hashlib|pickle|args|argparse|log|logging|shutil|glob|zip|zipfile|subprocess|socket|queue|sqlite|sqlite3|functools|enum|typing|url|encoding|dotenv|config|array|series|matrix|linear|probability|fraction|complex|calculus|units|table|dataset|cookie|cors|template|static|upload|tilemap|http_server|router|dns|toml|yaml|xml|markdown|crypto|jwt|session|auth|email|smtp|imap|ftp|ssh|websocket|ai|embedding|ml|tensor|video|camera|gui|window|canvas|input|sprite|physics|sound|keyboard|mouse|animation|scene|collision|image|audio)\\b"
        }
      ]
    },
    "builtin-functions": {
      "patterns": [
        {
          "name": "support.function.builtin.se",
          "match": "\\b(?:say|ask|set|bytes)\\b"
        }
      ]
    },
    "member-access": {
      "patterns": [
        {
          "match": "(\\.)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "punctuation.accessor.se"
            },
            "2": {
              "name": "variable.other.member.se"
            }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.compound.se",
          "match": "\\+=|-=|\\*=|/=|%="
        },
        {
          "name": "keyword.operator.comparison.se",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.assignment.se",
          "match": "="
        },
        {
          "name": "keyword.operator.arithmetic.se",
          "match": "\\+|-|\\*|/|%"
        },
        {
          "name": "keyword.operator.range.se",
          "match": "\\.\\."
        },
        {
          "name": "keyword.operator.arrow.se",
          "match": "->"
        },
        {
          "name": "punctuation.separator.type-annotation.se",
          "match": ":"
        }
      ]
    }
  }
}

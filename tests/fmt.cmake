file(MAKE_DIRECTORY "${SE_WORK}")
set(source "${SE_WORK}/format.se")
file(WRITE "${source}" "if true\r\n\tsay \"ok\"  \r\n")
execute_process(COMMAND "${SE_EXE}" fmt --check "${source}" RESULT_VARIABLE before)
if(before EQUAL 0)
  message(FATAL_ERROR "fmt --check should fail on unformatted source")
endif()
execute_process(COMMAND "${SE_EXE}" fmt "${source}" RESULT_VARIABLE format_code)
if(NOT format_code EQUAL 0)
  message(FATAL_ERROR "fmt failed")
endif()
file(READ "${source}" formatted)
if(NOT formatted STREQUAL "if true\n    say \"ok\"\n")
  message(FATAL_ERROR "fmt produced wrong output: [${formatted}]")
endif()
execute_process(COMMAND "${SE_EXE}" fmt --check "${source}" RESULT_VARIABLE after)
if(NOT after EQUAL 0)
  message(FATAL_ERROR "fmt --check rejected formatted source")
endif()
execute_process(COMMAND "${SE_EXE}" fmt "${source}" RESULT_VARIABLE again)
file(READ "${source}" second)
if(NOT again EQUAL 0 OR NOT second STREQUAL formatted)
  message(FATAL_ERROR "fmt was not idempotent")
endif()
execute_process(COMMAND "${SE_EXE}" check "${source}" RESULT_VARIABLE valid)
if(NOT valid EQUAL 0)
  message(FATAL_ERROR "fmt broke valid SE")
endif()

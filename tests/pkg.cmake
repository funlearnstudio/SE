file(REMOVE_RECURSE "${SE_WORK}")
file(MAKE_DIRECTORY "${SE_WORK}")
file(WRITE "${SE_WORK}/helper.se" "make plus1 x:Int -> Int\n    give x + 1\n")
file(WRITE "${SE_WORK}/app.se" "use helper\nsay plus1 41\n")
execute_process(COMMAND "${SE_EXE}" pkg init WORKING_DIRECTORY "${SE_WORK}" RESULT_VARIABLE init)
if(NOT init EQUAL 0)
  message(FATAL_ERROR "se pkg init failed")
endif()
execute_process(COMMAND "${SE_EXE}" pkg add helper.se WORKING_DIRECTORY "${SE_WORK}" RESULT_VARIABLE install)
if(NOT install EQUAL 0)
  message(FATAL_ERROR "se pkg add failed")
endif()
file(REMOVE "${SE_WORK}/helper.se")
execute_process(COMMAND "${SE_EXE}" run app.se WORKING_DIRECTORY "${SE_WORK}"
  RESULT_VARIABLE run_code OUTPUT_VARIABLE output ERROR_VARIABLE errors)
if(NOT run_code EQUAL 0 OR NOT output STREQUAL "42\n")
  message(FATAL_ERROR "Project-local use helper failed: ${output} ${errors}")
endif()
execute_process(COMMAND "${SE_EXE}" pkg verify WORKING_DIRECTORY "${SE_WORK}" RESULT_VARIABLE verified)
if(NOT verified EQUAL 0)
  message(FATAL_ERROR "Local package verification failed")
endif()
file(APPEND "${SE_WORK}/.se/packages/helper.se" "# changed\n")
execute_process(COMMAND "${SE_EXE}" pkg verify WORKING_DIRECTORY "${SE_WORK}" RESULT_VARIABLE corrupted)
if(corrupted EQUAL 0)
  message(FATAL_ERROR "Package tamper check did not detect changed source")
endif()
execute_process(COMMAND "${SE_EXE}" pkg remove helper WORKING_DIRECTORY "${SE_WORK}" RESULT_VARIABLE removed)
if(NOT removed EQUAL 0)
  message(FATAL_ERROR "Package removal failed")
endif()
execute_process(COMMAND "${SE_EXE}" pkg verify WORKING_DIRECTORY "${SE_WORK}" RESULT_VARIABLE clean)
if(NOT clean EQUAL 0)
  message(FATAL_ERROR "Package lock after removal is invalid")
endif()

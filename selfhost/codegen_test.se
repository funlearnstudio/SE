# Bootstrap compiler pipeline smoke test, written entirely in SE.
use parser
use codegen
use text
use test

source = try read "selfhost/sample.se"
ast = try parse source
cpp = try emit_program ast
test.equal 2 ast.len
test.ok (text.contains cpp "auto name = std::string")
test.ok (text.contains cpp "if (")
test.ok (text.contains cpp "se_say(")
test.ok (text.contains cpp "return 0;")
try write "selfhost/generated_sample.cpp" cpp

math_source = "x = 2 + 3 * 4\nsay x\n"
math_cpp = try emit_program (try parse math_source)
test.ok (text.contains math_cpp "(std::int64_t{3} * std::int64_t{4})")
test.ok (text.contains math_cpp "se_add(std::int64_t{2}, (std::int64_t{3} * std::int64_t{4}))")

# C++ must see typed declarations before either recursive function definition.
forward_source = try read "selfhost/cases/language_forward_functions.se"
forward_ast = try parse forward_source
forward_cpp = try emit_program forward_ast
test.ok (text.contains forward_cpp "bool is_even(std::int64_t n);")
test.ok (text.contains forward_cpp "bool is_odd(std::int64_t n);")
test.ok (text.contains forward_cpp "return is_odd((n - std::int64_t{1}));")
test.ok (text.contains forward_cpp "return is_even((n - std::int64_t{1}));")

zero_source = "make answer -> Int\n    give 42\nsay answer\nsay answer + 1\n"
zero_cpp = try emit_program (try parse zero_source)
test.ok (text.contains zero_cpp "se_implicit_call(answer)")
test.ok (text.contains zero_cpp "se_add(se_implicit_call(answer), std::int64_t{1})")

say "SE selfhost codegen smoke test passed"

use parser
use json
use ast_codec
use test

make node encoded:Text -> List[Text]
    give unpack_node encoded

source = "match 2\n    case 1\n        say \"one\"\n    case 2\n        say \"two\"\n    else\n        say \"other\"\n"
ast = try parse source
test.equal 1 ast.len
match_node = node ast[0]
test.equal "Match" match_node[0]
choices = node match_node[2]
test.equal 2 choices.len
first = node choices[0]
first_body = try unpack_block (first[1])
test.equal 1 first_body.len
fallback = try unpack_block (match_node[3])
test.equal 1 fallback.len
say "SE selfhost match parser passed"

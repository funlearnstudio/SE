use decimal
use datetime
use test

test.equal (try decimal.parse "001.2500") "1.25"
test.equal (try decimal.add "0.1" "0.2") "0.3"
test.equal (try decimal.sub "2" "0.5") "1.5"
test.equal (try decimal.mul "1.5" "2") "3"
test.equal (try decimal.div "1" "3" 4) "0.3333"
test.equal (try decimal.quantize "1.5" 2) "1.50"
test.equal (try datetime.from_timestamp 0) "1970-01-01T00:00:00Z"
test.equal (try datetime.format 0 "%Y/%m/%d") "1970/01/01"
test.equal (try datetime.add_seconds 30 (-60)) (-30)
now = datetime.timestamp
current = datetime.now
say "decimal and datetime passed"

use data
use test

make identity value:Any -> Any
    give value

values = identity [1, 2]
data.append values 3
data.insert values 1 9
test.equal (int values[1]) 9
test.equal (int (data.pop values 1)) 9
test.equal (int values[2]) 3
copy = data.copy values
data.clear copy
test.equal copy.len 0
test.equal values.len 3
mapping = identity ["a": 1]
data.set mapping "b" 2
test.equal (int (data.get mapping "a")) 1
test.equal (int (data.get mapping "missing" 42)) 42
test.ok (data.has mapping "b")
updates = ["a": 7, "c": 3]
data.update mapping updates
test.equal (int mapping["a"]) 7
test.equal (data.keys mapping) ["a", "b", "c"]
data_values = data.values mapping
test.equal (int data_values[0]) 7
test.equal (int data_values[1]) 2
test.equal (int data_values[2]) 3
pairs = data.items mapping
test.equal (text pairs[0][0]) "a"
test.equal (int pairs[0][1]) 7
test.ok (data.delete mapping "b")
test.equal (data.keys mapping) ["a", "c"]
data.clear mapping
test.equal mapping.len 0
say "dynamic data API passed"

use statistics
use regex
use re
use test

values = [1, 3, 5]
test.equal (statistics.mean values) 3
test.equal (statistics.median values) 3
test.equal (statistics.variance values) 4
test.equal (statistics.stdev values) 2
test.ok (regex.match "[a-z]+" "compiler")
test.ok (re.search "[0-9]+" "SE42")
test.equal (regex.replace "[0-9]+" "SE42" "!") "SE!"
parts = regex.split "," "a,b,c"
test.equal parts.len 3
say "statistics and regex passed"

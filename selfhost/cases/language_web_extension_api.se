use cookie
use cors
use template
use static
use tilemap
use test

cookies = cookie.parse "sid=abc123; theme = dark"
test.equal cookies["sid"] "abc123"
test.equal cookies["theme"] "dark"
test.equal (cookie.set "sid" "new") "sid=new; Path=/; SameSite=Lax"

headers = cors.preflight "https://example.test" "GET, POST"
test.equal headers["Access-Control-Allow-Origin"] "https://example.test"
test.equal headers["Access-Control-Allow-Methods"] "GET, POST"
test.equal (template.escape "<x & \"y\">") "&lt;x &amp; &quot;y&quot;&gt;"
values = ["name": "<SE>"]
test.equal (template.render "<p>{{ name }}</p>" values) "<p>&lt;SE&gt;</p>"
test.equal (static.mime "main.css") "text/css; charset=utf-8"

grid = tilemap.parse "###\n#.#\n###"
tile = tilemap.at grid 1 1
test.equal tile "."
dimensions = tilemap.size grid
test.equal dimensions[0] 3
test.equal dimensions[1] 3
try
    tilemap.parse "##\n#"
else error
    test.equal error.message "Tilemap rows must have equal width."
say "web extension API passed"

use test
use file
use hash
use hashlib

test.equal (try hash.sha256 "abc") "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"
test.equal (try hashlib.sha512 "abc") "ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f"
test.equal (try hashlib.digest "sha1" "abc") "a9993e364706816aba3e25717850c26c9cd0d89d"
test.equal (try hashlib.hmac_sha256 "key" "message") "6e9ef29b75fffc5b7abae527d58fdadb2fe42e7219011976917343065f58ed4a"
test.ok (try hashlib.compare "same" "same")
test.ok (not (try hashlib.compare "same" "other"))
test.equal (try hashlib.to_hex "abc") "616263"
hash_file = "selfhost/cases/.selfhost-hash-test.txt"
file.write hash_file "abc"
test.equal (try hash.file_sha256 hash_file) "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"
test.equal (try hashlib.file_sha512 hash_file) "ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f"
test.equal (try hashlib.file_digest "sha1" hash_file) "a9993e364706816aba3e25717850c26c9cd0d89d"
file.remove hash_file
say "Hash APIs passed"

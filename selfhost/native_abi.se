# Native metadata is parsed and lowered into typed SE AST in SE itself.
use text
use lexer
use json
use ast_codec

make native_node encoded:Text -> List[Text]
    give unpack_node encoded

make native_type kind:Text -> Bool
    if kind in ["Int", "Num", "Bool", "Text", "Bytes", "None"]
        give true
    give text.starts kind "Handle:" and kind.len > 7

make parse_native source:Text metadata:Text -> List[Text]
    declarations = []
    library = ""
    lines = text.split source "\n"
    for line in lines
        line = text.replace line "\t" " "
        comments = text.split line "#"
        words = text.split (text.trim comments[0]) " "
        fields = []
        for word in words
            if word != ""
                fields.add word
        if fields.len > 0
            if fields[0] == "library"
                if fields.len != 2 or library != ""
                    fail "Native metadata needs one library name."
                library = fields[1]
            else
                if fields.len < 4
                    fail "Incomplete native function declaration."
                # The SE export is an identifier. The C symbol is a dlsym
                # string and may contain punctuation such as an ABI suffix.
                characters = text.split fields[0] ""
                if characters.len == 0 or not (is_letter characters[0])
                    fail "Invalid native identifier."
                for character in characters
                    if not (is_word character)
                        fail "Invalid native identifier."
                index = 2
                types = []
                params = []
                args = []
                while index < fields.len and fields[index] != "->"
                    kind = fields[index]
                    if not (native_type kind) or kind == "None"
                        fail "Invalid native argument type: " + kind
                    types.add kind
                    name = "abi_arg_" + string index
                    params.add (json.stringify ([name, kind]))
                    args.add (json.stringify (["Atom", "Identifier", name, ""]))
                    index += 1
                if index + 1 >= fields.len
                    fail "Native function needs -> ReturnType."
                result = fields[index + 1]
                if not (native_type result)
                    fail "Invalid native result type: " + result
                index += 2
                fallible = "false"
                cleanup = ""
                while index < fields.len
                    if fields[index] == "fallible"
                        fallible = "true"
                    else if fields[index] == "cleanup" and index + 1 < fields.len
                        index += 1
                        cleanup = fields[index]
                    else
                        fail "Unknown native declaration option."
                    index += 1
                if cleanup != "" and not (text.starts result "Handle:")
                    fail "Native cleanup requires a Handle result."
                expression = json.stringify (["NativeCall", metadata, library, fields[1], result, json.stringify types, json.stringify args, fallible, cleanup, fields[0]])
                body = [json.stringify (["give", "", expression, ""])]
                declarations.add (json.stringify (["Make", fields[0], json.stringify params, try pack_block body, result, "[]"]))
    if library == ""
        fail "Native metadata has no library line."
    result = [json.stringify (["NativeLoad", metadata, library])]
    index = 0
    while index < declarations.len
        result.add declarations[index]
        index += 1
    give result

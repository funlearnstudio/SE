# C++20 backend written in SE for the bootstrap subset.
# Emits calls to selfhost/se_bootstrap_runtime.hpp for basic SE semantics.
use json
use text
use ast_codec
use type_model

make _node encoded:Text -> List[Text]
    give json.parse encoded

make _indent depth:Int -> Text
    give text.repeat "    " depth

make _clone_names entries:List[Text] -> List[Text]
    names = []
    for item in entries
        names.add item
    give names

make _ctype source:Text -> Text
    parts = decompose_type source
    if parts[0] == "List" and parts.len == 2
        give "std::vector<" + (try _ctype parts[1]) + ">"
    if parts[0] == "Set" and parts.len == 2
        give "SESet<" + (try _ctype parts[1]) + ">"
    if parts[0] == "Map" and parts.len == 3 and parts[1] == "Text"
        give "SEMap<" + (try _ctype parts[2]) + ">"
    if source == "Int"
        give "std::int64_t"
    if source == "Num"
        give "double"
    if source == "Text"
        give "std::string"
    if source == "Bool"
        give "bool"
    if source == "Time"
        give "SETime"
    if source == "File"
        give "SEFile"
    if source == "List[Int]"
        give "std::vector<std::int64_t>"
    if source == "List[Num]"
        give "std::vector<double>"
    if source == "List[List[Text]]"
        give "std::vector<std::vector<std::string>>"
    if source == "List[List[Int]]"
        give "std::vector<std::vector<std::int64_t>>"
    if source == "List[Text]"
        give "std::vector<std::string>"
    if source == "List[Bool]"
        give "std::vector<bool>"
    if source == "Map[Text,Int]"
        give "SEMap<std::int64_t>"
    if source == "Map[Text,Text]"
        give "SEMap<std::string>"
    if source == "Map[Text,Num]"
        give "SEMap<double>"
    if source == "Map[Text,Bool]"
        give "SEMap<bool>"
    if source == "Set[Int]"
        give "SESet<std::int64_t>"
    if source == "Set[Text]"
        give "SESet<std::string>"
    if source == "Set[Num]"
        give "SESet<double>"
    if source == "Set[Bool]"
        give "SESet<bool>"
    if source in ["T", "U", "V", "K", "E", "R", "A", "B"]
        give source
    if source == "Unknown"
        give "auto"
    if parts.len > 1
        arguments = []
        i = 1
        while i < parts.len
            arguments.add (try _ctype parts[i])
            i += 1
        give "SEType_" + parts[0] + "<" + (text.join arguments ", ") + ">"
    characters = text.split source ""
    if characters.len > 0
        if text.contains "ABCDEFGHIJKLMNOPQRSTUVWXYZ" characters[0]
            give "SEType_" + source
    fail "Unsupported C++ type annotation: " + source

# Preserve mutable cursor, token and symbol-table arguments across calls.
make _parameter_type declared:Text name:Text -> Text
    result = try _ctype declared
    if declared in ["List[Int]", "List[Num]", "List[Text]", "List[Bool]", "List[List[Text]]", "List[List[Int]]"]
        if name in ["state", "tokens", "symbols", "entries", "names", "loaded", "bindings"]
            give result + "&"
        give "const " + result + "&"
    give result

make _emit_template encoded:Text -> Text
    node = _node encoded
    if node.len < 6
        give ""
    vars = _node node[5]
    result = ""
    for v in vars
        if result != ""
            result = result + ", "
        result = result + "typename " + v
    if result == ""
        give ""
    give "template <" + result + ">\n"

# Keep SE identifiers distinct from reserved C++20 tokens.
make _cpp_identifier name:Text -> Text
    if name in ["alignas","alignof","and","and_eq","asm","auto","bitand","bitor","bool","break","case","catch","char","char8_t","char16_t","char32_t","class","compl","concept","const","consteval","constexpr","constinit","const_cast","continue","co_await","co_return","co_yield","decltype","default","delete","do","double","dynamic_cast","else","enum","explicit","export","extern","false","float","for","friend","goto","if","inline","int","long","mutable","namespace","new","noexcept","not","not_eq","nullptr","operator","or","or_eq","private","protected","public","register","reinterpret_cast","requires","return","short","signed","sizeof","static","static_assert","static_cast","struct","switch","template","this","thread_local","throw","true","try","typedef","typeid","typename","union","unsigned","using","virtual","void","volatile","wchar_t","while","xor","xor_eq"]
        give "se_keyword_" + name
    give name

make _emit_arguments encoded:Text -> Text
    args = _node encoded
    parts = []
    for item in args
        parts.add (try _emit_expr item)
    give text.join parts ", "

make _emit_call encoded:Text -> Text
    node = _node encoded
    target = _node node[1]
    args = _node node[2]
    generated = try _emit_arguments node[2]
    if target[0] == "Atom" and target[1] == "Identifier"
        name = target[2]
        if name in ["int", "integer"]
            give "se_int(" + generated + ")"
        if name in ["num", "float", "double"]
            give "se_num(" + generated + ")"
        if name == "bool" or name == "boolean"
            give "se_bool(" + generated + ")"
        if name in ["text", "string"]
            give "se_string(" + generated + ")"
        if name == "wait"
            give "se_wait(" + generated + ")"
        if name == "char"
            give "se_char(" + generated + ")"
        if name == "read"
            give "se_read(" + generated + ")"
        if name == "write"
            give "se_write(" + generated + ")"
        if name == "append"
            give "se_append(" + generated + ")"
        if name == "open"
            give "se_file_open(" + generated + ")"
        cpp_name = _cpp_identifier name
        give cpp_name + "(" + generated + ")"
    if target[0] == "Member"
        owner = _node target[1]
        method = target[2]
        if owner[0] == "Atom" and owner[1] == "Identifier"
            module = owner[2]
            if module == "os"
                if method == "getenv"
                    give "se_getenv(" + generated + ")"
                fail "OS module function not yet supported: " + method
            if module == "json"
                if method == "stringify"
                    give "se_json_stringify(" + generated + ")"
                if method == "parse"
                    give "se_json_parse(" + generated + ")"
                fail "JSON module function not yet supported: " + method
            if module == "path"
                if method in ["join", "name", "ext", "parent", "exists", "is_file", "is_dir"]
                    give "se_path_" + method + "(" + generated + ")"
                fail "Path function not yet supported: " + method
            if module == "random"
                if method == "int"
                    give "se_random_int(" + generated + ")"
                fail "Random module function not yet supported: " + method
            if module == "base64"
                if method == "encode"
                    give "se_base64_encode(" + generated + ")"
                if method == "decode"
                    give "se_base64_decode(" + generated + ")"
                fail "Base64 module function not yet supported: " + method
            if module == "time"
                if method == "now"
                    give "se_time_now()"
                if method == "unix"
                    give "se_time_unix(" + generated + ")"
                if method == "from_unix"
                    give "se_time_from_unix(" + generated + ")"
                if method == "iso"
                    give "se_time_iso(" + generated + ")"
                fail "Time module function not yet supported: " + method
            if module == "file"
                if method == "read"
                    give "se_read(" + generated + ")"
                if method == "write"
                    give "se_write(" + generated + ")"
                if method == "append"
                    give "se_append(" + generated + ")"
                if method == "open"
                    give "se_file_open(" + generated + ")"
                if method in ["copy", "move", "copytree", "remove", "mkdir"]
                    give "se_file_" + method + "(" + generated + ")"
                fail "File module function not yet supported: " + method
            if module == "test"
                if method == "ok"
                    give "se_test_ok(" + generated + ")"
                if method == "equal"
                    give "se_test_equal(" + generated + ")"
                if method == "not_equal"
                    give "se_test_not_equal(" + generated + ")"
                if method == "fail"
                    give "se_test_fail(" + generated + ")"
                fail "Test module function not supported: " + method
            if module == "statistics"
                if method in ["mean", "median", "pvariance", "pstdev", "variance", "stdev"]
                    give "se_statistics_" + method + "(" + generated + ")"
                fail "Unknown statistics function: " + method
            if module == "regex" or module == "re"
                if method in ["match", "search", "replace", "split"]
                    give "se_regex_" + method + "(" + generated + ")"
                fail "Unknown regex function: " + method
            if module == "math"
                if method in ["cbrt", "abs", "floor", "ceil", "round", "trunc", "sin", "cos", "tan", "asin", "acos", "atan", "sinh", "cosh", "tanh", "asinh", "acosh", "atanh", "exp", "exp2", "expm1", "log", "log10", "log2", "log1p", "gamma", "lgamma", "erf", "erfc", "pow", "atan2", "fmod", "remainder", "copysign", "nextafter", "sqrt", "degrees", "radians", "hypot", "min", "max", "clamp", "lerp", "map_range", "sign", "isfinite", "isinf", "isnan", "gcd", "lcm", "factorial", "comb", "perm", "sum", "mean", "median", "variance", "stddev"]
                    give "se_math_" + method + "(" + generated + ")"
                fail "Math module function not yet supported: " + method
            if module == "text"
                if method in ["split", "trim", "contains", "repeat", "join", "starts", "ends", "replace"]
                    give "se_" + method + "(" + generated + ")"
                fail "Text module function not yet supported: " + method
            if module == "collections"
                if method == "sort"
                    give "se_sorted(" + generated + ")"
                if method == "reverse"
                    give "se_reversed(" + generated + ")"
                if method == "take"
                    give "se_take(" + generated + ")"
                if method == "drop"
                    give "se_drop(" + generated + ")"
                if method == "slice"
                    give "se_slice(" + generated + ")"
                if method == "filter"
                    give "se_filter(" + generated + ")"
                if method == "map"
                    give "se_transform(" + generated + ")"
                if method == "reduce"
                    give "se_reduce(" + generated + ")"
                if method == "sort_with"
                    give "se_sort_with(" + generated + ")"
                fail "Collection function not yet supported: " + method
        obj = try _emit_expr target[1]
        if method == "add"
            give "se_add_item(" + obj + ", " + generated + ")"
        if method == "remove"
            give "se_remove_item(" + obj + ", " + generated + ")"
        # A user-defined object's method is a regular C++20 member call.
        cpp_method = _cpp_identifier method
        give obj + "." + cpp_method + "(" + generated + ")"
    fail "Only named functions and supported module methods can be called."

make _emit_expr encoded:Text -> Text
    node = _node encoded
    kind = node[0]
    if kind == "Atom"
        value_kind = node[1]
        raw = node[2]
        if value_kind == "String"
            quoted = json.stringify raw
            give "std::string(" + quoted + ")"
        if value_kind == "Integer"
            give "std::int64_t{" + raw + "}"
        if value_kind == "Duration"
            give "se_duration(" + (json.stringify raw) + ")"
        if value_kind == "Identifier"
            # Production SE auto-invokes zero-argument functions referenced as
            # values. Preserve ordinary values and higher-arity callbacks.
            give "se_implicit_call(" + (_cpp_identifier raw) + ")"
        if value_kind in ["Number", "true", "false"]
            give raw
        fail "Unrecognized literal: " + value_kind
    if kind == "TypeInstance"
        arguments = _node node[2]
        cpp_args = []
        for argument in arguments
            cpp_args.add (try _ctype argument)
        give "SEType_" + node[1] + "<" + (text.join cpp_args ", ") + ">{}"
    if kind == "Unary"
        op = node[1]
        if op == "not"
            op = "!"
        rhs = try _emit_expr node[2]
        give "(" + op + rhs + ")"
    if kind == "Binary"
        op = node[1]
        left = try _emit_expr node[2]
        right = try _emit_expr node[3]
        if op == "**"
            give "std::pow(" + left + ", " + right + ")"
        if op == ".."
            give "se_range(" + left + ", " + right + ")"
        if op == "in"
            give "se_contains(" + right + ", " + left + ")"
        if op == "+"
            give "se_add(" + left + ", " + right + ")"
        if op == "and"
            op = "&&"
        if op == "or"
            op = "||"
        if op == "/"
            give "(se_num(" + left + ") / se_num(" + right + "))"
        give "(" + left + " " + op + " " + right + ")"
    if kind == "List"
        items = try _emit_arguments node[1]
        give "se_list(" + items + ")"
    if kind == "Map"
        pairs = _node node[1]
        output = ""
        for item in pairs
            pair = _node item
            key = try _emit_expr pair[0]
            value = try _emit_expr pair[1]
            if output != ""
                output = output + ", "
            output = output + "std::pair{" + key + ", " + value + "}"
        give "se_map(" + output + ")"
    if kind == "Set"
        items = try _emit_arguments node[1]
        give "se_set(" + items + ")"
    if kind == "Index"
        base = try _emit_expr node[1]
        index = try _emit_expr node[2]
        give "se_index(" + base + ", " + index + ")"
    if kind == "Member"
        owner = _node node[1]
        member = node[2]
        if owner[0] == "Atom" and owner[1] == "Identifier"
            module = owner[2]
            if member == "help"
                give "se_module_help(" + (json.stringify module) + ")"
            if module == "math"
                if member == "pi"
                    give "std::numbers::pi_v<double>"
                if member == "e"
                    give "std::numbers::e_v<double>"
                if member == "tau"
                    give "(2.0 * std::numbers::pi_v<double>)"
                if member == "inf"
                    give "std::numeric_limits<double>::infinity()"
            if module == "random" and member == "num"
                give "se_random_num()"
            if module == "os"
                if member == "platform"
                    give "se_platform()"
                if member == "cwd"
                    give "se_cwd()"
            if module == "time" and member == "now"
                give "se_time_now()"
        base = try _emit_expr node[1]
        member = node[2]
        if member == "help"
            give "se_help_text(" + base + ")"
        if member == "message"
            give base + ".message"
        if member == "kind"
            give base + ".kind"
        if member == "len"
            give "static_cast<std::int64_t>(" + base + ".size())"
        if member == "upper" or member == "lower"
            give "se_" + member + "(" + base + ")"
        # A static C++20 property-or-zero-argument-method expression.
        # Requires-expressions discard the invalid branch at compilation time.
        cpp_member = _cpp_identifier member
        give "([&](auto&& __se_object)->decltype(auto){if constexpr (requires { __se_object." + cpp_member + "(); }) return __se_object." + cpp_member + "(); else return (__se_object." + cpp_member + ");})(" + base + ")"
    if kind == "Call"
        give try _emit_call encoded
    if kind == "Ask"
        question = try _emit_expr node[1]
        give "se_ask(" + question + ")"
    if kind == "Try"
        give try _emit_expr node[1]
    fail "Unsupported AST expression for C++ codegen: " + kind

# Generate a C++20 concrete object type with fields and methods.
make _emit_type encoded:Text -> Text
    node = _node encoded
    fields = _node node[2]
    methods = try unpack_block node[3]
    generics = []
    if node.len > 4
        generics = _node node[4]
    header = ""
    if generics.len > 0
        declarations = []
        for variable in generics
            declarations.add ("typename " + variable)
        header = "template <" + (text.join declarations ", ") + ">\n"
    output = header + "struct SEType_" + node[1] + " {\n"
    field_names = []
    for encoded_field in fields
        field = _node encoded_field
        value = try _emit_expr field[1]
        field_names.add field[0]
        cpp_field = _cpp_identifier field[0]
        if field.len > 2 and field[2] != "Unknown"
            field_cpp_type = try _ctype field[2]
            if field[3] == "required"
                output = output + "    " + field_cpp_type + " " + cpp_field + "{};\n"
            else
                output = output + "    " + field_cpp_type + " " + cpp_field + " = " + value + ";\n"
        else
            output = output + "    decltype(" + value + ") " + cpp_field + " = " + value + ";\n"
    for encoded_method in methods
        method = _node encoded_method
        parameters = _node method[2]
        arguments = ""
        local_names = _clone_names field_names
        parameter_names = []
        for encoded_param in parameters
            parameter = _node encoded_param
            typename = try _parameter_type parameter[1] parameter[0]
            if arguments != ""
                arguments = arguments + ", "
            cpp_parameter = _cpp_identifier parameter[0]
            arguments = arguments + typename + " " + cpp_parameter
            parameter_names.add parameter[0]
            local_names.add parameter[0]
        prelude = ""
        for encoded_field in fields
            field = _node encoded_field
            if not (field[0] in parameter_names)
                cpp_field = _cpp_identifier field[0]
                prelude = prelude + "        auto& " + cpp_field + " = this->" + cpp_field + ";\n"
        return_type = try _ctype method[4]
        body = try _emit_block method[3] 2 local_names
        cpp_method = _cpp_identifier method[1]
        output = output + "    " + return_type + " " + cpp_method + "(" + arguments + ") {\n"
        output = output + prelude + body + "    }\n"
    cpp_type = _cpp_identifier node[1]
    output = output + "};\n"
    if generics.len == 0
        output = output + "inline const SEType_" + node[1] + " " + cpp_type + "{};\n"
    give output

make _emit_block encoded:Text level:Int names:List[Text] -> Text
    statements = try unpack_block encoded
    parts = []
    for item in statements
        generated = try _emit_stmt item level names
        parts.add generated
    give text.join parts ""

make _emit_stmt encoded:Text level:Int names:List[Text] -> Text
    node = _node encoded
    kind = node[0]
    pad = _indent level
    if kind == "Assign"
        name = node[1]
        expr = try _emit_expr node[2]
        cpp_name = _cpp_identifier name
        if name in names
            give pad + cpp_name + " = " + expr + ";\n"
        names.add name
        give pad + "auto " + cpp_name + " = " + expr + ";\n"
    if kind == "AssignInit"
        name = node[1]
        expr = try _emit_expr node[2]
        output = ""
        cpp_name = _cpp_identifier name
        if name in names
            output = pad + cpp_name + " = " + expr + ";\n"
        else
            names.add name
            output = pad + "auto " + cpp_name + " = " + expr + ";\n"
        fields = _node node[3]
        for encoded_field in fields
            field = _node encoded_field
            value = try _emit_expr field[1]
            cpp_field = _cpp_identifier field[0]
            output = output + pad + cpp_name + "." + cpp_field + " = " + value + ";\n"
        give output
    if kind == "TypeDecl"
        give try _emit_type encoded
    if kind == "say"
        printable = try _emit_expr node[2]
        give pad + "se_say(" + printable + ");\n"
    if kind == "give"
        result = try _emit_expr node[2]
        give pad + "return " + result + ";\n"
    if kind == "fail"
        result = try _emit_expr node[2]
        give pad + "throw std::runtime_error(se_string(" + result + "));\n"
    if kind == "AssignIndex"
        base = try _emit_expr node[1]
        index = try _emit_expr node[2]
        value = try _emit_expr node[3]
        give pad + "se_index(" + base + ", " + index + ") = " + value + ";\n"
    if kind == "AssignMember"
        base = try _emit_expr node[1]
        value = try _emit_expr node[3]
        cpp_field = _cpp_identifier node[2]
        give pad + base + "." + cpp_field + " = " + value + ";\n"
    if kind == "MultiAsk"
        fields = _node node[1]
        suffix = string names.len
        line_name = "__se_line_" + suffix
        values_name = "__se_values_" + suffix
        stream_name = "__se_stream_" + suffix
        token_name = "__se_token_" + suffix
        output = pad + "std::string " + line_name + ";\n"
        output = output + pad + "if (!std::getline(std::cin, " + line_name + ")) throw std::runtime_error(\"Input ended\");\n"
        output = output + pad + "std::istringstream " + stream_name + "(" + line_name + ");\n"
        output = output + pad + "std::vector<std::string> " + values_name + ";\n"
        output = output + pad + "std::string " + token_name + ";\n"
        output = output + pad + "while (" + stream_name + " >> " + token_name + ") " + values_name + ".push_back(" + token_name + ");\n"
        output = output + pad + "if (" + values_name + ".size() != " + string fields.len + ") throw std::runtime_error(\"Wrong ask field count\");\n"
        i = 0
        for item in fields
            field = _node item
            expr = values_name + ".at(" + string i + ")"
            if field[1] == "Int"
                expr = "se_int(" + expr + ")"
            if field[1] == "Num"
                expr = "se_num(" + expr + ")"
            if field[0] in names
                cpp_field = _cpp_identifier field[0]
                output = output + pad + cpp_field + " = " + expr + ";\n"
            else
                names.add field[0]
                typename = try _ctype field[1]
                cpp_field = _cpp_identifier field[0]
                output = output + pad + typename + " " + cpp_field + " = " + expr + ";\n"
            i += 1
        give output
    if kind == "ExprStmt"
        expr_node = _node node[2]
        if expr_node[0] == "Member" and expr_node[2] == "help"
            printable = try _emit_expr node[2]
            give pad + "se_say(" + printable + ");\n"
        result = try _emit_expr node[2]
        give pad + result + ";\n"
    if kind == "Use"
        if node[1] in ["math", "text", "collections", "file", "json", "os", "random", "path", "time", "base64", "test", "statistics", "regex", "re"]
            give ""
        fail "C++ bootstrap backend cannot yet import module: " + node[1]
    if kind == "TryStmt"
        protected_names = _clone_names names
        protected = try _emit_block node[1] (level + 1) protected_names
        output = pad + "try {\n" + protected + pad + "} catch (const std::exception& __se_caught) {\n"
        recovery = try unpack_block node[3]
        if recovery.len > 0
            error_names = _clone_names names
            error_names.add node[2]
            fallback = try _emit_block node[3] (level + 1) error_names
            cpp_error = _cpp_identifier node[2]
            output = output + pad + "    SEError " + cpp_error + "{__se_caught.what()};\n"
            output = output + fallback
        else
            output = output + pad + "    throw;\n"
        give output + pad + "}\n"
    if kind == "Match"
        value = try _emit_expr node[1]
        choices = _node node[2]
        local_name = "__se_match_value"
        output = pad + "{\n"
        output = output + pad + "    const auto " + local_name + " = " + value + ";\n"
        first = true
        for encoded_case in choices
            choice = _node encoded_case
            pattern = try _emit_expr choice[0]
            branch_names = _clone_names names
            body = try _emit_block choice[1] (level + 2) branch_names
            if first
                output = output + pad + "    if ("
                first = false
            else
                output = output + " else if ("
            output = output + local_name + " == " + pattern + ") {\n"
            output = output + body + pad + "    }"
        fallback = try unpack_block node[3]
        if fallback.len > 0
            branch_names = _clone_names names
            body = try _emit_block node[3] (level + 2) branch_names
            output = output + " else {\n" + body + pad + "    }"
        give output + "\n" + pad + "}\n"
    if kind == "If"
        yes_ast = node[2]
        no_ast = node[3]
        test_ast = node[1]
        then_names = _clone_names names
        else_names = _clone_names names
        yes = try _emit_block yes_ast (level + 1) then_names
        no = try _emit_block no_ast (level + 1) else_names
        condition = try _emit_expr test_ast
        output = pad + "if (" + condition + ") {\n" + yes + pad + "}"
        if no != ""
            output = output + " else {\n" + no + pad + "}"
        give output + "\n"
    if kind == "while"
        loop_names = _clone_names names
        body = try _emit_block node[2] (level + 1) loop_names
        condition = try _emit_expr node[1]
        give pad + "while (" + condition + ") {\n" + body + pad + "}\n"
    if kind == "repeat"
        loop_names = _clone_names names
        body = try _emit_block node[2] (level + 1) loop_names
        count = try _emit_expr node[1]
        give pad + "for (std::int64_t _se_i = 0; _se_i < " + count + "; ++_se_i) {\n" + body + pad + "}\n"
    if kind == "ForPairs"
        scope = _clone_names names
        scope.add node[1]
        scope.add node[2]
        body = try _emit_block node[4] (level + 1) scope
        iterable = try _emit_expr node[3]
        output = pad + "for (const auto& __se_pair : " + iterable + ".items) {\n"
        cpp_first = _cpp_identifier node[1]
        cpp_second = _cpp_identifier node[2]
        output = output + pad + "    auto " + cpp_first + " = __se_pair.first;\n"
        output = output + pad + "    auto " + cpp_second + " = __se_pair.second;\n"
        give output + body + pad + "}\n"
    if kind == "For"
        scope = _clone_names names
        scope.add node[1]
        body = try _emit_block node[3] (level + 1) scope
        iterable = try _emit_expr node[2]
        cpp_loop = _cpp_identifier node[1]
        give pad + "for (auto " + cpp_loop + " : " + iterable + ") {\n" + body + pad + "}\n"
    if kind == "Make"
        params = _node node[2]
        local_names = []
        if level > 0
            local_names = _clone_names names
        args = ""
        concrete = node[4] != "Unknown"
        arg_types = []
        for item in params
            param = _node item
            typename = try _parameter_type param[1] param[0]
            if param[1] == "Unknown"
                concrete = false
            if args != ""
                args = args + ", "
            cpp_param = _cpp_identifier param[0]
            args = args + typename + " " + cpp_param
            arg_types.add typename
            local_names.add param[0]
        result_type = try _ctype node[4]
        cpp_function = _cpp_identifier node[1]
        if level > 0
            if node.len > 5
                variables = _node node[5]
                if variables.len > 0
                    fail "Nested generic functions are not supported yet."
            # Capture surrounding lexical variables. Typed lambdas use
            # std::function so self-recursion is valid in C++20.
            names.add node[1]
            local_names.add node[1]
            body = try _emit_block node[3] (level + 1) local_names
            if concrete
                signature = result_type + "(" + (text.join arg_types ", ") + ")"
                give pad + "std::function<" + signature + "> " + cpp_function + " = [&](" + args + ") -> " + result_type + " {\n" + body + pad + "};\n"
            give pad + "auto " + cpp_function + " = [&](" + args + ") -> " + result_type + " {\n" + body + pad + "};\n"
        body = try _emit_block node[3] 1 local_names
        header = try _emit_template encoded
        give header + result_type + " " + cpp_function + "(" + args + ") {\n" + body + "}\n"
    fail "Unsupported AST statement for C++ codegen: " + kind

# Emit forward declarations for functions with explicit signatures. This lets
# typed SE functions call functions defined later, including mutual recursion.
# Unknown return or parameter types cannot be safely forward-declared in C++20.
make _emit_prototype encoded:Text -> Text
    node = _node encoded
    if node[4] == "Unknown"
        give ""
    params = _node node[2]
    arguments = ""
    for item in params
        param = _node item
        if param[1] == "Unknown"
            give ""
        if arguments != ""
            arguments = arguments + ", "
        cpp_param = _cpp_identifier param[0]
        arguments = arguments + (try _parameter_type param[1] param[0]) + " " + cpp_param
    return_type = try _ctype node[4]
    header = try _emit_template encoded
    cpp_function = _cpp_identifier node[1]
    give header + return_type + " " + cpp_function + "(" + arguments + ");\n"

make emit_program ast:List[Text] -> Text
    type_parts = []
    prototype_parts = []
    function_parts = []
    body_parts = []
    names = []
    # C++ needs declarations before definitions for mutual recursion and forward calls.
    for stmt in ast
        node = _node stmt
        if node[0] == "Make"
            prototype_parts.add (try _emit_prototype stmt)
        if node[0] == "TypeDecl"
            type_parts.add (try _emit_type stmt)
            type_parts.add "\n"
    for stmt in ast
        node = _node stmt
        if node[0] == "Make"
            generated = try _emit_stmt stmt 0 names
            function_parts.add generated
            function_parts.add "\n"
        else if node[0] != "TypeDecl"
            generated = try _emit_stmt stmt 2 names
            body_parts.add generated
    type_decls = text.join type_parts ""
    prototypes = text.join prototype_parts ""
    functions = text.join function_parts ""
    body = text.join body_parts ""
    give "#include \"se_bootstrap_runtime.hpp\"\n\n" + type_decls + prototypes + "\n" + functions + "int main() {\n    try {\n" + body + "        return 0;\n    } catch (const std::exception& e) {\n        std::cerr << e.what() << '\\n';\n        return 1;\n    }\n}\n"

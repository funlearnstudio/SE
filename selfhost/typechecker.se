# SE self-hosted compiler: semantic analysis and static type checking.
# Supported subset: typed/untyped functions, List, numeric/boolean/Text
# expressions, local scopes, bounded loops, declarations and module names.
use json
use text
use symbol_table
use collections
use ast_codec
use type_model

make _node encoded:Text -> List[Text]
    give json.parse encoded

make _compatible expected:Text actual:Text -> Bool
    give type_matches expected actual

make _field_type field:List[Text] symbols:List[List[Text]] -> Text
    if field.len > 2 and field[2] != "Unknown"
        give field[2]
    give try _infer field[1] symbols

make _user_shape type_name:Text symbols:List[List[Text]] -> List[Text]
    parts = decompose_type type_name
    give lookup_symbol symbols parts[0]

make _user_bindings type_name:Text shape:List[Text] -> List[List[Text]]
    bindings = [["", ""]]
    bindings = collections.take bindings 0
    actual = decompose_type type_name
    generics = []
    if shape.len > 6
        generics = _node shape[6]
    if generics.len > 0
        if actual.len != generics.len + 1
            fail "Generic type " + shape[0] + " needs " + string(generics.len) + " type arguments."
        i = 0
        while i < generics.len
            bindings.add ([generics[i], actual[i + 1]])
            i += 1
    else if actual.len > 1
        fail "Non-generic type " + shape[0] + " cannot take type arguments."
    give bindings

make _validate_type source:Text symbols:List[List[Text]] -> Text
    if text.starts source "Handle:"
        give "OK"
    if source == "Unknown"
        give "OK"
    parts = decompose_type source
    base = parts[0]
    if base in ["Int", "Num", "Bool", "Text", "Time", "File", "Duration", "Error", "Bytes", "None", "Any"]
        if parts.len != 1
            fail "Type " + base + " does not accept type arguments."
        give "OK"
    if base in ["List", "Set", "Map"]
        count = 2
        if base == "Map"
            count = 3
        if parts.len != count
            fail "Wrong type argument count for " + base
        index = 1
        while index < parts.len
            try _validate_type parts[index] symbols
            index += 1
        if base == "Map" and parts[1] != "Text"
            fail "Map keys must be Text."
        give "OK"
    shape = lookup_symbol symbols base
    if shape[1] == "TypeParameter" and parts.len == 1
        give "OK"
    if shape[1] == "UserType"
        try _user_bindings source shape
        index = 1
        while index < parts.len
            try _validate_type parts[index] symbols
            index += 1
        give "OK"
    fail "Unknown type annotation: " + source

make _add_generics encoded:Text symbols:List[List[Text]] -> Text
    variables = _node encoded
    for variable in variables
        symbols.add ([variable, "TypeParameter", "0", ""])
    give "OK"

make _numeric kind:Text -> Bool
    # Generic type parameters may use operators when the concrete call-site
    # type supplies that operator. The generated C++ template remains the
    # final constraint check for unsupported instantiations.
    give kind == "Int" or kind == "Num" or kind == "Unknown" or kind == "TypeParameter"

make _generic_type kind:Text symbols:List[List[Text]] -> Bool
    shape = lookup_symbol symbols kind
    give shape[1] == "TypeParameter"

make _infer encoded:Text symbols:List[List[Text]] -> Text
    node = _node encoded
    kind = node[0]
    if kind == "NativeCall"
        give node[4]
    if kind == "Atom"
        token = node[1]
        if token == "Integer"
            give "Int"
        if token == "Number"
            give "Num"
        if token == "Duration"
            give "Duration"
        if token == "String"
            give "Text"
        if token == "true" or token == "false"
            give "Bool"
        if token == "Identifier"
            record = lookup_symbol symbols node[2]
            if record[0] == ""
                fail "Undefined identifier: " + node[2]
            if record[1] == "UserType"
                try _user_bindings record[0] record
                give record[0]
            # A bare reference to a zero-parameter SE function evaluates the
            # function immediately, just as the production interpreter does.
            if record[1] == "Function" and record[2] == "0"
                give record[3]
            give record[1]
    if kind == "TypeInstance"
        shape = lookup_symbol symbols node[1]
        if shape[1] != "UserType"
            fail "Unknown generic user type: " + node[1]
        arguments = _node node[2]
        name = node[1] + "[" + (text.join arguments ",") + "]"
        try _user_bindings name shape
        give name
    if kind == "Unary"
        operand = try _infer node[2] symbols
        if node[1] == "not"
            if not _compatible "Bool" operand
                fail "not expects Bool, got " + operand
            give "Bool"
        if not _numeric operand and not (_generic_type operand symbols)
            fail "Unary - needs a number, got " + operand
        give operand
    if kind == "Binary"
        left = try _infer node[2] symbols
        right = try _infer node[3] symbols
        op = node[1]
        if op == "and" or op == "or"
            if not _compatible "Bool" left or not _compatible "Bool" right
                fail "Logical operation requires Bool operands."
            give "Bool"
        if op in ["==", "!=", "in"]
            give "Bool"
        if op in ["<", "<=", ">", ">="]
            if (not _numeric left and not (_generic_type left symbols)) or (not _numeric right and not (_generic_type right symbols))
                fail "Comparison requires numeric operands."
            give "Bool"
        if op == ".."
            if left != "Int" or right != "Int"
                fail "Range endpoints must be Int."
            give "List[Int]"
        if op == "+" and (left == "Text" or right == "Text")
            give "Text"
        if (not _numeric left and not (_generic_type left symbols)) or (not _numeric right and not (_generic_type right symbols))
            fail "Arithmetic requires numbers, got " + left + " and " + right
        if left == right and _generic_type left symbols and op != "/"
            give left
        if op == "/" or op == "**" or left == "Num" or right == "Num"
            give "Num"
        give "Int"
    if kind == "List"
        items = _node node[1]
        element = "Unknown"
        for item in items
            got = try _infer item symbols
            if element == "Unknown"
                element = got
            else if not _compatible element got
                if element == "Int" and got == "Num"
                    element = "Num"
                else
                    fail "List element type mismatch: " + element + " vs " + got
        give "List[" + element + "]"
    if kind == "Map"
        pairs = _node node[1]
        element = "Unknown"
        for item in pairs
            pair = _node item
            key_type = try _infer pair[0] symbols
            if key_type != "Text"
                fail "Map keys must be Text."
            got = try _infer pair[1] symbols
            if element == "Unknown"
                element = got
            else if not _compatible element got
                if element == "Int" and got == "Num"
                    element = "Num"
                else
                    fail "Map values must have the same type."
        give "Map[Text," + element + "]"
    if kind == "Set"
        items = _node node[1]
        element = "Unknown"
        for item in items
            got = try _infer item symbols
            if element == "Unknown"
                element = got
            else if not _compatible element got
                if element == "Int" and got == "Num"
                    element = "Num"
                else
                    fail "Set values must have the same type."
        give "Set[" + element + "]"
    if kind == "Index"
        container = try _infer node[1] symbols
        index_type = try _infer node[2] symbols
        parts = decompose_type container
        if parts[0] == "Map" and parts.len == 3
            if not (type_matches parts[1] index_type)
                fail "Map key must be " + parts[1] + "."
            give parts[2]
        if parts[0] == "List" and parts.len == 2
            if index_type != "Int" and index_type != "Unknown"
                fail "List index must be Int."
            give parts[1]
        if container == "Bytes"
            if index_type != "Int" and index_type != "Unknown"
                fail "Bytes index must be Int."
            give "Int"
        if container == "Unknown"
            give "Unknown"
        fail "Only List and Map indexing supported, got " + container
    if kind == "Member"
        object_type = try _infer node[1] symbols
        member = node[2]
        owner = _node node[1]
        if member == "help"
            give "Text"
        if owner[0] == "Atom" and owner[1] == "Identifier"
            if owner[0] == "Atom" and owner[1] == "Identifier" and owner[2] == "uuid" and member == "v4"
                give "Text"
            if owner[2] == "dynamic" and member in ["type_of", "is"]
                give "Function"
            if owner[2] == "math" and member in ["pi", "e", "tau", "inf"]
                give "Num"
            if owner[2] == "random" and member == "num"
                give "Num"
            if owner[2] == "os" and member in ["platform", "cwd"]
                give "Text"
            if owner[2] == "time" and member == "now"
                give "Time"
            if owner[2] == "datetime"
                if member == "now"
                    give "Text"
                if member == "timestamp"
                    give "Int"
        if member == "message" and object_type == "Error"
            give "Text"
        if member == "kind" and object_type == "Error"
            give "Text"
        if object_type == "File" and member == "read"
            give "Text"
        if object_type == "File" and member in ["write", "close"]
            give "Function"
        parts = decompose_type object_type
        if member == "len"
            if object_type in ["Text", "Bytes", "Unknown"] or parts[0] in ["List", "Map", "Set"]
                give "Int"
        if member == "upper" or member == "lower"
            if object_type == "Text" or object_type == "Unknown"
                give "Text"
        if member in ["add", "remove"]
            if object_type == "Unknown" or parts[0] in ["List", "Set"]
                give "Function"
            if member == "remove" and parts[0] == "Map"
                give "Function"
        if object_type == "Module"
            give "Function"
        user_type = _user_shape object_type symbols
        if user_type[1] == "UserType"
            bindings = try _user_bindings object_type user_type
            fields = _node user_type[4]
            for encoded_field in fields
                field = _node encoded_field
                if field[0] == member
                    give resolve_type (try _field_type field symbols) bindings
            methods = try unpack_block user_type[5]
            for encoded_method in methods
                method = _node encoded_method
                if method[1] == member
                    give resolve_type method[4] bindings
        fail "Unknown member " + member + " of " + object_type
    if kind == "Call"
        callee = _node node[1]
        args = _node node[2]
        if callee[0] == "Member"
            call_owner = _node callee[1]
            if call_owner[0] == "Atom" and call_owner[1] == "Identifier" and call_owner[2] == "dynamic"
                method = callee[2]
                if method == "type_of"
                    if args.len != 1
                        fail "dynamic.type_of expects one value."
                    give "Text"
                if method == "is"
                    if args.len != 2
                        fail "dynamic.is expects a value and a type name."
                    give "Bool"
                fail "Unknown dynamic operation: " + method
            if call_owner[0] == "Atom" and call_owner[1] == "Identifier" and call_owner[2] == "operator"
                method = callee[2]
                if not (method in ["add", "sub", "mul", "div", "mod", "eq", "ne", "lt", "le", "gt", "ge"])
                    fail "Unknown operator function: " + method
                if args.len != 2
                    fail "operator." + method + " expects two arguments."
                left_type = try _infer args[0] symbols
                right_type = try _infer args[1] symbols
                if method in ["eq", "ne", "lt", "le", "gt", "ge"]
                    give "Bool"
                if left_type == "Text" and right_type == "Text" and method == "add"
                    give "Text"
                if not (left_type in ["Int", "Num", "Unknown"]) or not (right_type in ["Int", "Num", "Unknown"])
                    fail "operator." + method + " expects compatible operands."
                if method == "div" or left_type == "Num" or right_type == "Num"
                    give "Num"
                give "Int"
        for item in args
            try _infer item symbols
        if callee[0] == "Atom" and callee[1] == "Identifier"
            name = callee[2]
            if name == "read"
                if args.len != 1
                    fail "read expects one file path."
                give "Text"
            if name == "open"
                if args.len != 1
                    fail "open expects one file path."
                give "File"
            if name == "write" or name == "append"
                if args.len != 2
                    fail name + " expects path and text."
                give "Unknown"
            if name == "wait"
                if args.len != 1
                    fail "wait expects one Duration."
                wait_type = try _infer args[0] symbols
                if wait_type != "Duration" and wait_type != "Unknown"
                    fail "wait expects a Duration value."
                give "Unknown"
            if name == "bytes"
                if args.len != 1
                    fail "bytes needs one Text argument."
                give "Bytes"
            if name == "char"
                if args.len != 1
                    fail "char expects one argument."
                codepoint_type = try _infer args[0] symbols
                if codepoint_type != "Int" and codepoint_type != "Text" and codepoint_type != "Unknown"
                    fail "char expects an Int codepoint or one-character Text."
                give "Text"
            if name == "int" or name == "integer"
                if args.len != 1
                    fail "int expects one argument."
                give "Int"
            if name == "num" or name == "float" or name == "double"
                if args.len != 1
                    fail "num expects one argument."
                give "Num"
            if name == "bool" or name == "boolean"
                if args.len != 1
                    fail "bool expects one argument."
                bool_type = try _infer args[0] symbols
                if bool_type != "Bool" and bool_type != "Text" and bool_type != "Unknown"
                    fail "bool needs Bool or Text true/false."
                give "Bool"
            if name == "string" or name == "text"
                if args.len != 1
                    fail "text expects one argument."
                give "Text"
            entry = lookup_symbol symbols name
            if entry[0] == ""
                fail "Undefined function: " + name
            if entry[1] == "Unknown"
                for argument in args
                    try _infer argument symbols
                give "Unknown"
            if entry[1] != "Function"
                fail "Cannot call non-function: " + name
            if int entry[2] != args.len
                fail "Wrong arity for " + name + ": expected " + entry[2]
            bindings = [["", ""]]
            bindings = collections.take bindings 0
            if entry.len > 5
                variables = _node entry[5]
                for variable in variables
                    bindings.add ([variable, "Unknown"])
            if entry.len > 4
                signature = _node entry[4]
                i = 0
                while i < signature.len
                    pair = _node signature[i]
                    got = try _infer args[i] symbols
                    try bind_type pair[1] got bindings
                    if not _compatible (resolve_type pair[1] bindings) got
                        fail "Function " + name + " argument " + string(i + 1) + " expects " + pair[1] + ", got " + got
                    i += 1
            give resolve_type entry[3] bindings
        if callee[0] == "Member"
            owner_type = try _infer callee[1] symbols
            if owner_type == "Module"
                owner = _node callee[1]
                if owner[0] == "Atom" and owner[2] == "enum"
                    method = callee[2]
                    required = ["Map[Text,Int]", "Text"]
                    returned = "Unknown"
                    if method == "make"
                        required = ["List[Text]"]
                        returned = "Map[Text,Int]"
                    else if method == "name"
                        required = ["Map[Text,Int]", "Int"]
                        returned = "Text"
                    else if method == "value"
                        returned = "Int"
                    else if method == "has"
                        returned = "Bool"
                    else
                        fail "Unknown enum function: " + method
                    if args.len != required.len
                        fail "enum." + method + " expects " + string(required.len) + " arguments."
                    i = 0
                    while i < required.len
                        got = try _infer args[i] symbols
                        if not _compatible required[i] got
                            fail "enum." + method + " argument " + string(i + 1) + " needs " + required[i] + "."
                        i += 1
                    give returned
                if owner[0] == "Atom" and owner[2] == "datetime"
                    method = callee[2]
                    required = []
                    returned = "Text"
                    if method == "now"
                        required = []
                    else if method == "timestamp"
                        required = []
                        returned = "Int"
                    else if method == "from_timestamp"
                        required = ["Int"]
                    else if method == "format"
                        required = ["Int", "Text"]
                    else if method == "add_seconds"
                        required = ["Int", "Int"]
                        returned = "Int"
                    else
                        fail "Unknown datetime function: " + method
                    if args.len != required.len
                        fail "datetime." + method + " expects " + string(required.len) + " arguments."
                    i = 0
                    while i < required.len
                        got = try _infer args[i] symbols
                        if not _compatible required[i] got
                            fail "datetime." + method + " argument type mismatch."
                        i += 1
                    give returned
                if owner[0] == "Atom" and owner[2] == "iter"
                    method = callee[2]
                    if method == "range"
                        if args.len < 1 or args.len > 3
                            fail "iter.range expects 1 to 3 Int arguments."
                        for item in args
                            got = try _infer item symbols
                            if not _compatible "Int" got
                                fail "iter.range requires Int arguments."
                        give "List[Int]"
                    if method == "enumerate"
                        if args.len != 1
                            fail "iter.enumerate expects one List."
                        source_type = try _infer args[0] symbols
                        parts = decompose_type source_type
                        if parts[0] != "List" or parts.len != 2
                            fail "iter.enumerate expects a List."
                        if not (parts[1] in ["Int", "Num", "Bool", "Text", "Bytes"])
                            fail "iter.enumerate supports scalar List items in the bootstrap."
                        give "List[List[Any]]"
                    if method in ["zip", "product", "permutations", "combinations"]
                        required = 2
                        if method == "permutations"
                            if args.len < 1 or args.len > 2
                                fail "iter.permutations expects 1 or 2 arguments."
                        else if args.len != required
                            fail "iter." + method + " expects 2 arguments."
                        first = try _infer args[0] symbols
                        parts = decompose_type first
                        if parts[0] != "List" or parts.len != 2
                            fail "iter." + method + " expects a List."
                        if method in ["zip", "product"]
                            second = try _infer args[1] symbols
                            if not (type_matches first second) or not (type_matches second first)
                                fail "iter." + method + " needs Lists of compatible element types."
                        else if args.len == 2
                            count_type = try _infer args[1] symbols
                            if not _compatible "Int" count_type
                                fail "iter." + method + " expects an Int count."
                        give "List[" + first + "]"
                    fail "Unsupported iter function: " + method
                if owner[0] == "Atom" and owner[2] == "functools"
                    method = callee[2]
                    if not (method in ["partial", "reduce", "map", "filter"])
                        fail "Unknown functools function: " + method
                    if method == "partial"
                        if args.len < 1 or args.len > 64
                            fail "functools.partial needs 1 to 64 arguments."
                        give "Function"
                    if method == "reduce"
                        if args.len < 2 or args.len > 3
                            fail "functools.reduce expects 2 or 3 arguments."
                        if args.len == 3
                            give try _infer args[2] symbols
                        parts = decompose_type (try _infer args[1] symbols)
                        if parts[0] == "List" and parts.len == 2
                            give parts[1]
                        give "Unknown"
                    if args.len != 2
                        fail "functools." + method + " expects function and List."
                    got = try _infer args[1] symbols
                    if method == "filter"
                        give got
                    give "Unknown"
                if owner[0] == "Atom" and owner[2] == "glob"
                    method = callee[2]
                    expected = 1
                    returned = "List[Text]"
                    if method == "match"
                        expected = 2
                        returned = "Bool"
                    else if method != "find"
                        fail "Unknown glob function: " + method
                    if args.len != expected
                        fail "glob." + method + " expects " + string(expected) + " arguments."
                    for argument in args
                        got = try _infer argument symbols
                        if not _compatible "Text" got
                            fail "glob." + method + " expects Text arguments."
                    give returned
                if owner[0] == "Atom" and owner[2] == "hashlib"
                    method = callee[2]
                    expected = 1
                    returned = "Text"
                    if method == "compare"
                        expected = 2
                        returned = "Bool"
                    else if method != "to_hex"
                        fail "Unsupported hashlib function: " + method
                    if args.len != expected
                        fail "hashlib." + method + " expects " + string(expected) + " arguments."
                    for argument in args
                        got = try _infer argument symbols
                        if not _compatible "Text" got
                            fail "hashlib." + method + " expects Text arguments."
                    give returned
                if owner[0] == "Atom" and owner[2] == "itertools"
                    method = callee[2]
                    if not (method in ["chain", "flatten", "chunked", "take", "drop", "windows", "cycle", "pairs", "unique"])
                        fail "Unknown itertools function: " + method
                    expected = 1
                    if method in ["chunked", "take", "drop", "windows", "cycle"]
                        expected = 2
                    if method == "chain"
                        expected = args.len
                        if expected == 0 or expected > 64
                            fail "itertools.chain expects 1 to 64 lists."
                    if args.len != expected
                        fail "itertools." + method + " expects " + string(expected) + " arguments."
                    original = try _infer args[0] symbols
                    parts = decompose_type original
                    if parts[0] != "List" or parts.len != 2
                        if original == "Unknown"
                            give "Unknown"
                        fail "itertools." + method + " expects a List."
                    if method == "chain"
                        i = 1
                        while i < args.len
                            following = try _infer args[i] symbols
                            if not _compatible original following
                                fail "itertools.chain needs Lists of the same type."
                            i += 1
                    if method in ["chunked", "take", "drop", "windows", "cycle"]
                        width = try _infer args[1] symbols
                        if width != "Int" and width != "Unknown"
                            fail "itertools." + method + " expects an Int count."
                    if method == "flatten"
                        nested = decompose_type parts[1]
                        if nested[0] == "List" and nested.len == 2
                            give parts[1]
                    if method in ["pairs", "chunked", "windows"]
                        give "List[" + original + "]"
                    give original
                if owner[0] == "Atom" and owner[2] in ["shutil", "typing", "cookie", "cors", "template", "static", "upload", "dotenv", "config"]
                    module_name = owner[2]
                    member_name = callee[2]
                    required = []
                    returned = "Unknown"
                    if module_name == "shutil"
                        if member_name in ["copy", "move", "copytree"]
                            required = ["Text", "Text"]
                        else if member_name in ["remove", "mkdir"]
                            required = ["Text"]
                        else
                            fail "Unknown shutil function: " + member_name
                    else if module_name == "typing"
                        if member_name == "type_of"
                            required = ["Unknown"]
                            returned = "Text"
                        else if member_name == "is"
                            required = ["Unknown", "Text"]
                            returned = "Bool"
                        else if member_name == "cast"
                            required = ["Unknown", "Text"]
                            returned = try _infer args[0] symbols
                        else
                            fail "Unsupported typing function: " + member_name
                    else if module_name == "cookie"
                        if member_name == "parse"
                            required = ["Text"]
                            returned = "Map[Text,Text]"
                        else if member_name == "set"
                            required = ["Text", "Text"]
                            returned = "Text"
                        else
                            fail "Unknown cookie function: " + member_name
                    else if module_name == "cors"
                        if member_name == "allow_origin"
                            required = ["Text"]
                            returned = "Map[Text,Text]"
                        else if member_name == "preflight"
                            required = ["Text", "Text"]
                            returned = "Map[Text,Text]"
                        else
                            fail "Unknown CORS function: " + member_name
                    else if module_name == "template"
                        if member_name == "escape"
                            required = ["Text"]
                        else if member_name == "render"
                            required = ["Text", "Map[Text,Text]"]
                        else
                            fail "Unknown template function: " + member_name
                        returned = "Text"
                    else if module_name == "static"
                        if member_name == "mime"
                            required = ["Text"]
                        else if member_name == "read"
                            required = ["Text", "Text"]
                        else
                            fail "Unknown static function: " + member_name
                        returned = "Text"
                    else if module_name == "upload"
                        if member_name != "save"
                            fail "Unknown upload function: " + member_name
                        required = ["Text", "Text", "Text"]
                        returned = "Text"
                    else if module_name == "dotenv"
                        if member_name == "parse"
                            required = ["Text"]
                            returned = "Map[Text,Text]"
                        else if member_name == "get"
                            required = ["Map[Text,Text]", "Text"]
                            returned = "Text"
                        else
                            fail "Unknown dotenv function: " + member_name
                    else if module_name == "config"
                        if member_name == "parse"
                            required = ["Text"]
                            returned = "Map[Text,Text]"
                        else if member_name in ["get", "get_int", "get_bool", "section"]
                            required = ["Map[Text,Text]", "Text"]
                            if member_name == "get"
                                returned = "Text"
                            if member_name == "get_int"
                                returned = "Int"
                            if member_name == "get_bool"
                                returned = "Bool"
                            if member_name == "section"
                                returned = "Map[Text,Text]"
                        else if member_name == "merge"
                            required = ["Map[Text,Text]", "Map[Text,Text]"]
                            returned = "Map[Text,Text]"
                        else
                            fail "Unknown config function: " + member_name
                    if args.len != required.len
                        fail module_name + "." + member_name + " expects " + string(required.len) + " arguments."
                    j = 0
                    while j < required.len
                        got = try _infer args[j] symbols
                        if not _compatible required[j] got
                            fail module_name + "." + member_name + " argument " + string(j + 1) + " expects " + required[j] + ", got " + got
                        j += 1
                    give returned
                if owner[0] == "Atom" and owner[2] == "collections"
                    method = callee[2]
                    if method == "contains"
                        if args.len != 2
                            fail "collections.contains expects a collection and a value."
                        give "Bool"
                    if method in ["first", "last", "unique", "sort_by", "sort_by_desc"]
                        expected = 1
                        if method in ["sort_by", "sort_by_desc"]
                            expected = 2
                        if args.len != expected
                            fail "Wrong argument count for collections."
                        if method in ["sort_by", "sort_by_desc"]
                            key_type = try _infer args[1] symbols
                            if key_type != "Text" and key_type != "Unknown"
                                fail "collections.sort_by expects a Text key."
                        collection_type = try _infer args[0] symbols
                        collection_parts = decompose_type collection_type
                        if collection_parts[0] == "List" and collection_parts.len == 2
                            if method in ["first", "last"]
                                give collection_parts[1]
                            give collection_type
                    if method in ["keys", "values"]
                        if args.len != 1
                            fail "collections.keys/values expects one Map."
                        map_type = decompose_type (try _infer args[0] symbols)
                        if map_type[0] == "Map" and map_type.len == 3
                            if method == "keys"
                                give "List[Text]"
                            give "List[" + map_type[2] + "]"
                if owner[0] == "Atom" and owner[2] in ["cookie", "cors", "template"]
                    module = owner[2]
                    method = callee[2]
                    arity = 1
                    result_type = "Text"
                    if module == "cookie"
                        if method == "parse"
                            result_type = "Map[Text,Text]"
                        else if method == "set"
                            arity = 2
                        else
                            fail "Unknown cookie function: " + method
                    if module == "cors"
                        result_type = "Map[Text,Text]"
                        if method == "preflight"
                            arity = 2
                        else if method != "allow_origin"
                            fail "Unknown cors function: " + method
                    if module == "template"
                        if method == "render"
                            arity = 2
                        else if method != "escape"
                            fail "Unknown template function: " + method
                    if args.len != arity
                        fail module + "." + method + " expects " + string(arity) + " argument(s)."
                    i = 0
                    while i < args.len
                        expected = "Text"
                        if module == "template" and method == "render" and i == 1
                            expected = "Map[Text,Text]"
                        actual = try _infer args[i] symbols
                        if not (_compatible expected actual)
                            fail module + "." + method + " expects " + expected + ", got " + actual
                        i += 1
                    give result_type
                if owner[0] == "Atom" and owner[2] == "tilemap"
                    method = callee[2]
                    expected_count = 1
                    result_type = "List[Text]"
                    if method == "at"
                        expected_count = 3
                        result_type = "Text"
                    else if method == "size"
                        result_type = "List[Int]"
                    else if method != "parse"
                        fail "Unknown tilemap function: " + method
                    if args.len != expected_count
                        fail "tilemap." + method + " expects " + string(expected_count) + " arguments."
                    i = 0
                    while i < args.len
                        expected = "List[Text]"
                        if method == "parse"
                            expected = "Text"
                        if method == "at" and i > 0
                            expected = "Int"
                        got = try _infer args[i] symbols
                        if not (_compatible expected got)
                            fail "tilemap." + method + " expects " + expected + ", got " + got
                        i += 1
                    give result_type
                if owner[0] == "Atom" and owner[2] in ["url", "encoding"]
                    module = owner[2]
                    method = callee[2]
                    expected = "Text"
                    if module == "url" and method == "query"
                        expected = "Map[Text,Text]"
                    if module == "url" and not (method in ["encode", "decode", "query", "parse_query"])
                        fail "Unknown url function: " + method
                    if module == "encoding" and not (method in ["hex", "unhex", "utf8_valid"])
                        fail "Unknown encoding function: " + method
                    if args.len != 1
                        fail module + "." + method + " expects one argument."
                    actual = try _infer args[0] symbols
                    if not (_compatible expected actual)
                        fail module + "." + method + " expects " + expected + ", got " + actual
                    if module == "url" and method == "parse_query"
                        give "Map[Text,Text]"
                    if module == "encoding" and method == "utf8_valid"
                        give "Bool"
                    give "Text"
                if owner[0] == "Atom" and owner[2] == "time"
                    if callee[2] == "now"
                        if args.len != 0
                            fail "time.now expects no arguments."
                        give "Time"
                    if callee[2] == "unix"
                        if args.len != 1
                            fail "time.unix expects one Time."
                        give "Int"
                    if callee[2] == "from_unix"
                        if args.len != 1
                            fail "time.from_unix expects one Int."
                        give "Time"
                    if callee[2] == "iso"
                        if args.len != 1
                            fail "time.iso expects one Time."
                        give "Text"
                if owner[0] == "Atom" and owner[2] == "file"
                    if callee[2] == "open"
                        if args.len != 1
                            fail "file.open expects one path."
                        give "File"
                    if callee[2] == "read"
                        give "Text"
                    if callee[2] in ["write", "append", "copy", "move", "copytree", "remove", "mkdir"]
                        give "Unknown"
                give "Unknown"
            if owner_type == "File"
                if callee[2] == "write"
                    if args.len != 1
                        fail "File.write expects one Text."
                    give "Unknown"
                if callee[2] == "close"
                    if args.len != 0
                        fail "File.close expects no arguments."
                    give "Unknown"
            if callee[2] in ["add", "remove"]
                if args.len != 1
                    fail "Collection.add/remove expects exactly one value."
                give "Unknown"
            user_type = _user_shape owner_type symbols
            if user_type[1] == "UserType"
                bindings = try _user_bindings owner_type user_type
                methods = try unpack_block user_type[5]
                for encoded_method in methods
                    method = _node encoded_method
                    if method[1] == callee[2]
                        if method.len > 5
                            variables = _node method[5]
                            for variable in variables
                                bindings.add ([variable, "Unknown"])
                        parameters = _node method[2]
                        if parameters.len != args.len
                            fail "Wrong arity for method " + callee[2]
                        j = 0
                        while j < parameters.len
                            parameter = _node parameters[j]
                            found_type = try _infer args[j] symbols
                            try bind_type parameter[1] found_type bindings
                            expected_type = resolve_type parameter[1] bindings
                            if not _compatible expected_type found_type
                                fail "Method argument type mismatch."
                            j += 1
                        give resolve_type method[4] bindings
        fail "Unsupported call expression in bootstrap checker."
    if kind == "Ask"
        got = try _infer node[1] symbols
        if got != "Text" and got != "Unknown"
            fail "ask needs a Text question."
        give "Text"
    if kind == "Try"
        give try _infer node[1] symbols
    fail "Unsupported AST expression in self-hosted checker: " + kind

make _guarantees_return statements:List[Text] -> Bool
    for item in statements
        node = _node item
        if node[0] == "give" or node[0] == "fail"
            give true
        if node[0] == "TryStmt"
            protected = try unpack_block node[1]
            recovery = try unpack_block node[3]
            if recovery.len > 0 and try _guarantees_return protected and try _guarantees_return recovery
                give true
        if node[0] == "Match"
            options = _node node[2]
            fallback = try unpack_block node[3]
            if fallback.len > 0 and try _guarantees_return fallback
                every_case = true
                for encoded_case in options
                    case_pair = _node encoded_case
                    if not (try _guarantees_return (try unpack_block case_pair[1]))
                        every_case = false
                if every_case
                    give true
        if node[0] == "If"
            yes = try unpack_block node[2]
            no = try unpack_block node[3]
            if try _guarantees_return yes and try _guarantees_return no
                give true
    give false

make _check_block statements:List[Text] symbols:List[List[Text]] return_type:Text -> Text
    for item in statements
        try _check_statement item symbols return_type
    give "OK"

make _check_statement encoded:Text symbols:List[List[Text]] return_type:Text -> Text
    node = _node encoded
    kind = node[0]
    if kind == "Assign"
        inferred = try _infer node[2] symbols
        shape = _user_shape inferred symbols
        if shape[1] == "UserType"
            try _user_bindings inferred shape
            fields = _node shape[4]
            for encoded_field in fields
                field = _node encoded_field
                if field.len > 3 and field[3] == "required"
                    fail "Missing required field: " + field[0]
        try assign_symbol symbols node[1] inferred
        give "OK"
    if kind == "AssignInit"
        type_name = try _infer node[2] symbols
        user_type = _user_shape type_name symbols
        if user_type[1] != "UserType"
            fail "Initializer block requires a user-defined type."
        bindings = try _user_bindings type_name user_type
        fields = _node user_type[4]
        initializers = _node node[3]
        for encoded_init in initializers
            init = _node encoded_init
            matched = false
            for encoded_field in fields
                field = _node encoded_field
                if field[0] == init[0]
                    matched = true
                    declared = resolve_type (try _field_type field symbols) bindings
                    actual = try _infer init[1] symbols
                    if not _compatible declared actual
                        fail "Initializer field type mismatch: " + init[0]
            if not matched
                fail "Unknown initializer field: " + init[0]
        for encoded_field in fields
            field = _node encoded_field
            if field.len > 3 and field[3] == "required"
                supplied = false
                for encoded_init in initializers
                    init = _node encoded_init
                    if init[0] == field[0]
                        supplied = true
                if not supplied
                    fail "Missing required field: " + field[0]
        try assign_symbol symbols node[1] type_name
        give "OK"
    if kind == "AssignIndex"
        target_type = try _infer node[1] symbols
        index_type = try _infer node[2] symbols
        value_type = try _infer node[3] symbols
        element = "Unknown"
        parts = decompose_type target_type
        if parts[0] == "Map" and parts.len == 3
            if not (type_matches parts[1] index_type)
                fail "Map key assignment requires Text key."
            element = parts[2]
        else if parts[0] == "List" and parts.len == 2
            if index_type != "Int" and index_type != "Unknown"
                fail "List index assignment requires Int index."
            element = parts[1]
        else if target_type == "Bytes"
            if index_type != "Int" and index_type != "Unknown"
                fail "Bytes index must be Int."
            if value_type != "Int" and value_type != "Unknown"
                fail "Bytes assignments require an Int from 0 to 255."
            give "OK"
        else if target_type != "Unknown"
            fail "Assignment index target must be a List or Map."
        if not _compatible element value_type
            fail "Collection assignment expects " + element + ", got " + value_type
        give "OK"
    if kind == "AssignMember"
        type_name = try _infer node[1] symbols
        user_type = _user_shape type_name symbols
        if user_type[1] != "UserType"
            fail "Field assignment requires an object."
        bindings = try _user_bindings type_name user_type
        fields = _node user_type[4]
        for encoded_field in fields
            field = _node encoded_field
            if field[0] == node[2]
                declared = resolve_type (try _field_type field symbols) bindings
                actual = try _infer node[3] symbols
                if not _compatible declared actual
                    fail "Object field assignment type mismatch."
                give "OK"
        fail "Unknown object field: " + node[2]
    if kind == "MultiAsk"
        fields = _node node[1]
        for item in fields
            field = _node item
            try assign_symbol symbols field[0] field[1]
        give "OK"
    if kind == "ExprStmt"
        try _infer node[2] symbols
        give "OK"
    if kind == "Use"
        try define_symbol symbols node[1] "Module" "0" ""
        give "OK"
    if kind == "NativeLoad"
        give "OK"
    if kind == "fail"
        got = try _infer node[2] symbols
        if got != "Text" and got != "Unknown"
            fail "fail message must be Text."
        give "OK"
    if kind == "say" or kind == "give"
        got = try _infer node[2] symbols
        if kind == "give"
            if return_type == "TopLevel"
                fail "give may only occur inside a function."
            if not _compatible return_type got
                fail "Function return type is " + return_type + ", got " + got
        give "OK"
    if kind == "TryStmt"
        local = clone_symbols symbols
        try _check_block (try unpack_block node[1]) local return_type
        recovery = try unpack_block node[3]
        if recovery.len > 0
            errors = clone_symbols symbols
            try define_symbol errors node[2] "Error" "0" ""
            try _check_block recovery errors return_type
        give "OK"
    if kind == "Match"
        subject_type = try _infer node[1] symbols
        choices = _node node[2]
        for encoded_case in choices
            choice = _node encoded_case
            case_type = try _infer choice[0] symbols
            if not _compatible subject_type case_type and not _compatible case_type subject_type
                fail "Match case type mismatch: " + subject_type + " vs " + case_type
            local = clone_symbols symbols
            try _check_block (try unpack_block choice[1]) local return_type
        otherwise = clone_symbols symbols
        try _check_block (try unpack_block node[3]) otherwise return_type
        give "OK"
    if kind == "If" or kind == "while" or kind == "repeat"
        condition = try _infer node[1] symbols
        expected = "Bool"
        if kind == "repeat"
            expected = "Int"
        if not _compatible expected condition
            fail kind + " requires " + expected + ", got " + condition
        nested = clone_symbols symbols
        body = try unpack_block node[2]
        try _check_block body nested return_type
        if kind == "If"
            alternative = try unpack_block node[3]
            nested_else = clone_symbols symbols
            try _check_block alternative nested_else return_type
        give "OK"
    if kind == "ForPairs"
        iterable = try _infer node[3] symbols
        parts = decompose_type iterable
        if iterable != "Unknown" and not (parts[0] == "Map" and parts.len == 3)
            fail "Two-variable for expects a Map, got " + iterable
        element = "Unknown"
        key_type = "Text"
        if parts[0] == "Map" and parts.len == 3
            key_type = parts[1]
            element = parts[2]
        local = clone_symbols symbols
        try define_symbol local node[1] key_type "0" ""
        try define_symbol local node[2] element "0" ""
        try _check_block (try unpack_block node[4]) local return_type
        give "OK"
    if kind == "For"
        iterable = try _infer node[2] symbols
        element_type = "Unknown"
        parts = decompose_type iterable
        if parts[0] in ["List", "Set"] and parts.len == 2
            element_type = parts[1]
        if parts[0] == "Map" and parts.len == 3
            element_type = parts[1]
        recognized = parts[0] in ["List", "Set"] and parts.len == 2
        if parts[0] == "Map" and parts.len == 3
            recognized = true
        if iterable != "Unknown" and not recognized
            fail "for expects List, Set or Map, got " + iterable
        local = clone_symbols symbols
        try define_symbol local node[1] element_type "0" ""
        body = try unpack_block node[3]
        try _check_block body local return_type
        give "OK"
    if kind == "TypeDecl"
        fields = _node node[2]
        local = clone_symbols symbols
        if node.len > 4
            try _add_generics node[4] local
        for encoded_field in fields
            field = _node encoded_field
            field_type = try _field_type field local
            try _validate_type field_type local
            if field.len > 3 and field[3] == "default"
                actual_default = try _infer field[1] local
                if not _compatible field_type actual_default
                    fail "Field default type mismatch: " + field[0]
            try define_symbol local field[0] field_type "0" ""
        methods = try unpack_block node[3]
        for encoded_method in methods
            method = _node encoded_method
            parameters = _node method[2]
            inner = clone_symbols local
            if method.len > 5
                try _add_generics method[5] inner
            try _validate_type method[4] inner
            for encoded_param in parameters
                parameter = _node encoded_param
                try _validate_type parameter[1] inner
                try define_symbol inner parameter[0] parameter[1] "0" ""
            body = try unpack_block method[3]
            try _check_block body inner method[4]
            if method[4] != "Unknown" and not (try _guarantees_return body)
                fail "Method " + method[1] + " requires a return on all paths."
        give "OK"
    if kind == "Make"
        params = _node node[2]
        # Nested declarations become visible in their lexical scope. Top-level
        # functions are already predeclared by check_program for forward calls.
        entry = lookup_symbol symbols node[1]
        if entry[0] == ""
            try define_symbol symbols node[1] "Function" (string params.len) node[4]
            entry = lookup_symbol symbols node[1]
            entry.add node[2]
            if node.len > 5
                entry.add node[5]
            try replace_symbol symbols entry
        local = clone_symbols symbols
        if node.len > 5
            try _add_generics node[5] local
        try _validate_type node[4] local
        for item in params
            pair = _node item
            try _validate_type pair[1] local
            try define_symbol local pair[0] pair[1] "0" ""
        body = try unpack_block node[3]
        try _check_block body local node[4]
        if node[4] != "Unknown" and not (try _guarantees_return body)
            fail "Function " + node[1] + " is missing a return on some code paths."
        give "OK"
    fail "Unsupported AST statement in self-hosted checker: " + kind

make check_program statements:List[Text] -> List[List[Text]]
    symbols = [["", "", "", ""]]
    symbols = collections.take symbols 0
    # Register user type shapes first, enabling forward constructors/methods.
    for item in statements
        node = _node item
        if node[0] == "TypeDecl"
            try define_symbol symbols node[1] "UserType" "0" ""
            entry = lookup_symbol symbols node[1]
            entry.add node[2]
            entry.add node[3]
            if node.len > 4
                entry.add node[4]
            try replace_symbol symbols entry
    # Register functions first, enabling forward calls.
    for item in statements
        node = _node item
        if node[0] == "Make"
            params = _node node[2]
            try define_symbol symbols node[1] "Function" (string params.len) node[4]
            entry = lookup_symbol symbols node[1]
            entry.add node[2]
            if node.len > 5
                entry.add node[5]
            try replace_symbol symbols entry
    try _check_block statements symbols "TopLevel"
    give symbols
